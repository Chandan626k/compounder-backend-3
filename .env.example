# ─────────────────────────────────────────────────────────
# Compounder DNA Engine — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file: cp .env.example .env.local
# Set in Vercel: Dashboard → Project → Settings → Environment Variables
# NEVER commit .env.local or .env to git
# ─────────────────────────────────────────────────────────

# REQUIRED: OpenAI API key for investment narrative generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# OPTIONAL: Override the OpenAI model (default: gpt-4o-mini)
# Options: gpt-4o-mini (cheapest) | gpt-4o (better quality)
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Restrict CORS to your frontend domain (default: * allows all)
# Example: https://your-app.vercel.app
ALLOWED_ORIGIN=*
